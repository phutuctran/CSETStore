{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": false
  },
  "ignoreCommand": "exit 0",
  "rewrites": [
    { "source": "/api/orders/:id/status", "destination": "/api/orders/index?id=:id" },
    { "source": "/api/orders", "destination": "/api/orders/index" },
    { "source": "/api/products/auto-top5", "destination": "/api/products/index?action=auto-top5" },
    { "source": "/api/products/:id", "destination": "/api/products/[id]" },
    { "source": "/api/products", "destination": "/api/products/index" },
    { "source": "/api/reviews/:id", "destination": "/api/reviews/index?id=:id" },
    { "source": "/api/reviews", "destination": "/api/reviews/index" },
    { "source": "/api/coupons/:id", "destination": "/api/coupons/index?id=:id" },
    { "source": "/api/coupons", "destination": "/api/coupons/index" },
    { "source": "/api/categories/:id", "destination": "/api/categories/index?id=:id" },
    { "source": "/api/categories", "destination": "/api/categories/index" },
    { "source": "/api/users/:id", "destination": "/api/users/[id]" },
    { "source": "/api/users", "destination": "/api/users/index" },
    { "source": "/api/auth/login", "destination": "/api/auth/login" },
    { "source": "/api/theme", "destination": "/api/theme/index" },
    { "source": "/api/backup/download", "destination": "/api/backup/index" },
    { "source": "/api/backup/restore", "destination": "/api/backup/index" },
    { "source": "/api/backup", "destination": "/api/backup/index" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/sales", "destination": "/sales.html" }
  ]
}
